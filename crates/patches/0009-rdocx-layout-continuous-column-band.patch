+    /// Start the body band of a continuous member on a page that already
+    /// carries content, as Word does for a continuous section whose column
+    /// tracks differ from the member above it: the new tracks begin below the
+    /// content already placed and reach to the same bottom margin. Members
+    /// with the same tracks keep flowing in the current band untouched.
+    fn begin_band(&mut self, member: &'a SharedSection) {
+        let same_tracks = self.section_geometry.columns.len() == member.geometry.columns.len()
+            && self
+                .section_geometry
+                .columns
+                .iter()
+                .zip(&member.geometry.columns)
+                .all(|(left, right)| left.width == right.width && left.x == right.x);
+        if same_tracks {
+            return;
+        }
+        let page_bottom = self.page_geometry.margin_top + self.content_height;
+        let band_top = (self.page_geometry.margin_top + self.cursor_y.max(self.ink_bottom))
+            .min(page_bottom);
+        self.header_footer = member.header_footer.as_ref();
+        self.header_footer_semantics = member.header_footer_semantics.as_ref();
+        self.title_pg = member.title_pg;
+        self.footnotes_beneath_text = member.footnotes_beneath_text;
+        self.line_number_style = member.line_number_style;
+        self.section_geometry = member.geometry.clone();
