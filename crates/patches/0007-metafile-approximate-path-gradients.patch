+/// Approximates `EmfPlusPathGradientBrush` (brush type 3) with a linear
+/// gradient. The engine's paint vocabulary has no radial/path-gradient shape;
+/// rejecting the brush would drop the whole picture, so the surrounding
+/// colours become stops and the centre colour closes the ramp. `metafile`
+/// reports the approximation through `emfplus_path_gradient_approximate`.
+/// [kitty-pptx patch 0007]
+fn parse_path_gradient(
+    data: &[u8],
+    limits: &ResourceLimits,
+    record: Record<'_>,
+    diagnostics: &mut Vec<Diagnostic>,
+) -> Result<Paint> {
+    if data.len() < 12 {
+        return invalid(
+            record.origin,
+            record.index,
+            record.kind,
+            record.offset,
+            "truncated path-gradient brush",
+        );
+    }
+    let flags = u32_at(data, 0)?;
+    let wrap_mode = u32_at(data, 4)?;
+    if wrap_mode > 4 {
+        return invalid(
+            record.origin,
+            record.index,
+            record.kind,
+            record.offset,
+            "invalid path-gradient wrap mode",
+        );
+    }
+    let mut cursor = 8usize;
+    let transform = if flags & 2 != 0 {
+        let end = checked_advance(cursor, 24, data.len(), record, "path-gradient transform")?;
+        let value = read_transform(&data[cursor..end], record)?;
+        cursor = end;
+        value
+    } else {
+        Transform::IDENTITY
+    };
+    let center = argb(u32_at(data, cursor)?);
+    cursor += 4;
+    let count = i32_at(data, cursor)?;
+    cursor += 4;
+    if count < 0 {
+        return invalid(
+            record.origin,
+            record.index,
+            record.kind,
+            record.offset,
+            "negative path-gradient colour count",
+        );
+    }
+    let count = usize::try_from(count).map_err(|_| {
+        malformed(
+            record.origin,
+            record.index,
+            record.kind,
+            record.offset,
+            "path-gradient colour count overflow",
+        )
+    })?;
+    if count > limits.max_gradient_stops {
+        return Err(MetafileError::ResourceLimitExceeded {
+            resource: "EMF+ path-gradient colours",
+            actual: count as u64,
+            limit: limits.max_gradient_stops as u64,
+        });
+    }
+    checked_advance(
+        cursor,
+        count.checked_mul(4).ok_or_else(|| {
+            malformed(
+                record.origin,
+                record.index,
+                record.kind,
+                record.offset,
+                "path-gradient colour bytes overflow",
+            )
+        })?,
+        data.len(),
+        record,
+        "path-gradient surrounding colours",
+    )?;
+    let mut stops = Vec::with_capacity(count + 1);
+    for index in 0..count {
+        let offset = index as f64 / count.max(1) as f64;
+        stops.push(GradientStop {
+            offset,
+            color: argb(u32_at(data, cursor + index * 4)?),
+        });
+    }
+    if stops.is_empty() {
+        stops.push(GradientStop {
+            offset: 0.0,
+            color: center,
+        });
+    }
+    stops.push(GradientStop {
+        offset: 1.0,
+        color: center,
+    });
+    diagnostics.push(Diagnostic::warning(
+        "emfplus_path_gradient_approximate",
+        "EMF+ path gradient is approximated by a linear gradient",
+    ));
+    Ok(Paint::LinearGradient {
+        start: Point::new(0.0, 0.0),
+        end: Point::new(1.0, 0.0),
+        stops,
+        wrap_mode,
+        transform,
+        gamma_corrected: false,
+    })
+}
